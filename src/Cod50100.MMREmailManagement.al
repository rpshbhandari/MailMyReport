codeunit 70100 "MMR Email Management"
{
    procedure SendReportEmail(EntryNo: Integer): Boolean
    var
        ReportInbox: Record "Report Inbox";
        EmailSetup: Record "MMR Email Setup";
        Recipients: List of [Text];
        EmailMsg: Codeunit "Email Message";
        Email: Codeunit Email;
        InStr: InStream;
        FileName: Text;
        Subject: Text[250];
        Body: Text;
    begin
        if not ReportInbox.Get(EntryNo) then
            Error(
                'Report Inbox Entry %1 not found.',
                EntryNo);

        GetEmailSetup(
            ReportInbox."Report ID",
            EmailSetup);

        GetReportAttachment(
            ReportInbox,
            InStr,
            FileName);

        Recipients := GetRecipients(EmailSetup."Entry No.");

        Subject := BuildSubject(ReportInbox, EmailSetup);
        Body := BuildBody(ReportInbox, EmailSetup);

        EmailMsg.Create(
            Recipients,
            Subject,
            Body,
            EmailSetup."Send As HTML");

        if EmailSetup."Attach Report" then
            AddAttachment(
                EmailMsg,
                ReportInbox,
                InStr,
                FileName);

        exit(
            Email.Send(
                EmailMsg,
                Enum::"Email Scenario"::Notification));
    end;

    local procedure GetEmailSetup(
        ReportId: Integer;
        var EmailSetup: Record "MMR Email Setup")
    begin
        EmailSetup.SetRange("Report ID", ReportId);
        EmailSetup.SetRange(Enabled, true);

        if not EmailSetup.FindFirst() then
            Error(
                'No enabled email setup was found for report %1.',
                ReportId);
    end;

    local procedure GetReportAttachment(
        var ReportInbox: Record "Report Inbox";
        var InStr: InStream;
        var FileName: Text)
    begin
        ReportInbox.CalcFields("Report Output", "Report Name");

        FileName :=
            StrSubstNo(
                '%1_%2_%3.%4',
                DelChr(ReportInbox."Report Name", '=', '\/:*?"<>|'),
                ReportInbox."Entry No.",
                Format(CurrentDateTime(), 0, '<Year4><Month,2><Day,2>'),
                ReportInbox.Suffix());

        ReportInbox."Report Output".CreateInStream(InStr);
    end;

    local procedure BuildSubject(
        ReportInbox: Record "Report Inbox";
        EmailSetup: Record "MMR Email Setup"): Text[250]
    begin
        if EmailSetup."Subject Template" = '' then
            exit(
                StrSubstNo(
                    '[MailMyReport] %1',
                    ReportInbox.Description));

        exit(
            StrSubstNo(
                EmailSetup."Subject Template",
                ReportInbox.Description,
                Format(CurrentDateTime())));
    end;

    local procedure BuildBody(
        ReportInbox: Record "Report Inbox";
        EmailSetup: Record "MMR Email Setup"): Text
    begin
        if EmailSetup."Body Template" = '' then
            exit(
                StrSubstNo(
                    'Dear User,<br/><br/>' +
                    'Please find attached report <b>%1</b>.<br/><br/>' +
                    'Generated on: <b>%2</b><br/><br/>' +
                    'This email was automatically generated by MailMyReport.<br/><br/>' +
                    'Regards,<br/>' +
                    'Business Central',
                    ReportInbox.Description,
                    Format(CurrentDateTime())));

        exit(
            StrSubstNo(
                EmailSetup."Body Template",
                ReportInbox.Description,
                Format(CurrentDateTime())));
    end;

    local procedure AddAttachment(
        var EmailMsg: Codeunit "Email Message";
        ReportInbox: Record "Report Inbox";
        InStr: InStream;
        FileName: Text)
    begin
        case ReportInbox."Output Type" of
            ReportInbox."Output Type"::PDF:
                EmailMsg.AddAttachment(
                    FileName,
                    'application/pdf',
                    InStr);

            ReportInbox."Output Type"::Excel:
                EmailMsg.AddAttachment(
                    FileName,
                    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                    InStr);

            else
                Error(
                    'Unsupported output type %1 for report %2.',
                    Format(ReportInbox."Output Type"),
                    ReportInbox.Description);
        end;
    end;

    local procedure GetRecipients(SetupEntryNo: Integer): List of [Text]
    var
        Recipient: Record "MMR Report Recipient";
        Recipients: List of [Text];
        HasRecipients: Boolean;
    begin
        Recipient.SetRange("Setup Entry No.", SetupEntryNo);
        Recipient.SetRange(Active, true);

        if Recipient.FindSet() then
            repeat
                if Recipient."Email Address" = '' then
                    Error(
                        'Recipient %1 has an empty email address.',
                        Recipient."Entry No.");

                if not Recipients.Contains(Recipient."Email Address") then begin
                    Recipients.Add(Recipient."Email Address");
                    HasRecipients := true;
                end;
            until Recipient.Next() = 0;

        if not HasRecipients then
            Error('At least one active recipient must be configured for the selected report.');

        exit(Recipients);
    end;
}